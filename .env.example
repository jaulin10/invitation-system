
# Configuration de la base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invitation_system
DB_USER=votre_utilisateur_postgres
DB_PASSWORD=votre_mot_de_passe_postgres

# Configuration JWT pour l'authentification
JWT_SECRET=votre_secret_jwt_super_securise_ici_123456789

# Configuration Stripe (à obtenir depuis votre dashboard Stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique_stripe
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe

# Configuration serveur
PORT=3000
NODE_ENV=development

# URL de base pour les webhooks et liens
BASE_URL=http://localhost:3000
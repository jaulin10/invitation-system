{
  "name": "invitation-system",
  "version": "1.0.0",
  "description": "Dynamic invitation system with user authentication and payment processing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/migrate.js",
    "start:seed": "SEED_TEMPLATES=true node server.js",
    "dev:seed": "SEED_TEMPLATES=true nodemon server.js",
    "seed:templates": "node scripts/seedTemplates.js all",
    "seed:template": "node scripts/seedTemplates.js single",
    "seed:reseed": "node scripts/seedTemplates.js reseed",
    "seed:list": "node scripts/seedTemplates.js list",
    "seed:help": "node scripts/seedTemplates.js help"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "stripe": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "keywords": [
    "invitation",
    "nodejs",
    "postgresql",
    "stripe"
  ],
  "author": "Votre nom",
  "license": "ISC"
}
